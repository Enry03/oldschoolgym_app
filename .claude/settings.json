{
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": { "source": "github", "repo": "DietrichGebert/ponytail" }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"", "timeout": 180 }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "graphify hook-guard compact 2>/dev/null || true", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          { "type": "command", "command": "graphify hook-guard search 2>/dev/null || true", "timeout": 10 }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          { "type": "command", "command": "graphify hook-guard read 2>/dev/null || true", "timeout": 10 }
        ]
      }
    ]
  }
}
